{
  "manifest_version": 3,
  "name": "Media Workshop — Opera GX Connector",
  "version": "1.0.0",
  "description": "Connect your signed-in YouTube/Twitch session to your local Media Workshop, only when you click Connect.",
  "permissions": ["cookies"],
  "host_permissions": ["https://*.youtube.com/*", "https://*.twitch.tv/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [{
    "matches": ["http://127.0.0.1/*", "http://localhost/*"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "action": {"default_title": "Open Media Workshop"}
}
